#!/usr/bin/env python3
"""Sends Read and Grep to JUNON/Serena once per target, then gets out of the way.

Measured, not assumed. Claude Code's own history over the last fortnight: 8 398 tool calls, of which
305 (3.6%) went to serena and 5 041 (60%) to the file tools. opencode's database says the same thing
louder — its `explorer` agent made 319 calls in the two days after its prompt was rewritten to insist
on the symbolic tools, and **none** of them was a serena call.

So this is not written in a prompt. A prompt is advice; this is the tool call not happening.

**It refuses once per distinct target, then allows it.** `~/.claude/hooks/cbm-code-discovery-gate`
already blocks the first file-tool call of a session for codebase-memory; this is narrower on
purpose — it fires only where the symbolic route genuinely answers better, and it names the call that
does it. Repeating the same call runs it, so nothing is ever unreachable: a log file, a real text
search, a file outside any project all pass on the second attempt, and most pass on the first.

Fails open. Every unexpected condition ends in exit 0, because a hook that blocks the agent when its
own logic breaks is worse than no hook.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys
import time
from pathlib import Path

#: Where a symbol tree exists and reading the whole file is the wasteful way in.
CODE = re.compile(
    r"\.(ts|tsx|js|jsx|mjs|cjs|py|kt|kts|go|java|rs|rb|php|c|h|hpp|cc|cpp|swift|scala|cs|vue|svelte)$",
    re.IGNORECASE,
)

#: A bare name — what someone types looking for a definition, not for text.
IDENTIFIER = re.compile(r"^[A-Za-z_$][A-Za-z0-9_$]{2,}$")

#: Under this, the whole file is the cheaper answer and a nudge would be noise.
WHOLE_FILE_IS_FINE = 300

#: Whole-file reads of code allowed per session before the next one is refused.
#:
#: The size rule catches the wrong unit; this catches the wrong pattern — thirty files opened to find
#: one function. Swept over a fortnight of recorded calls before choosing: at five, the search agent's
#: refusal rate goes from 13.6% to 22.5%, while the agent that already reads by range moves 6.4% to
#: 7.4%. A rule that punishes the one doing it right is a rule that gets deleted.
WHOLE_FILE_BUDGET = 5

MARKERS = Path("/tmp")

#: Commands that answer a question the index answers better. Matched on the first word of each
#: `&&`/`;`/`|` segment — not a shell parser, and not trying to be. It catches
#: `cd /somewhere && grep -rn thing .`, which is the shape an agent used to walk around this gate on
#: the first day it ran; it misses quoting, subshells and aliases, deliberately, because a gate that
#: tries to understand shell is a gate that breaks builds at night.
SEARCH_COMMANDS = {"grep", "rg", "ag", "ack"}
READ_COMMANDS = {"cat", "bat"}

#: Refusals a session may ignore before the gate stops spending round-trips on it.
#:
#: Some agents have no serena at all — three of the first five refusals went to one of them, naming a
#: tool it could not call. Which agent is asking is not in the hook's input, but what the session has
#: done is: a session that has never used a symbolic tool and has now ignored two refusals is one the
#: gate cannot help.
GIVE_UP_AFTER = 2


def already_nudged(session: str, kind: str, target: str) -> bool:
    """One refusal per session and target. The second attempt is the agent's call, and it stands."""
    digest = hashlib.sha256(f"{kind}:{target}".encode()).hexdigest()[:16]
    marker = MARKERS / f"junon-first-gate-{session}-{digest}"
    if marker.exists():
        return True
    marker.touch()
    return False


def spend(session: str) -> int:
    """How many whole-file code reads this session has made, counting this one.

    On disk because each hook call is its own process: a counter in memory would reset every time and
    the budget would never be reached.
    """
    ledger = MARKERS / f"junon-first-gate-{session}.reads"
    try:
        with open(ledger, "a", encoding="utf-8") as handle:
            handle.write("1")
        return ledger.stat().st_size
    except OSError:
        return 0


def prune() -> None:
    cutoff = time.time() - 86_400
    for stale in MARKERS.glob("junon-first-gate-*"):
        try:
            if stale.stat().st_mtime < cutoff:
                stale.unlink()
        except OSError:
            pass


def _session_file(session: str, suffix: str) -> Path:
    return MARKERS / f"junon-first-gate-{session}.{suffix}"


def uses_symbolic_tools(session: str) -> bool:
    """Whether this session has ever called an `mcp__serena__*` tool.

    Recorded by the hook itself, which is why it must be registered for those tools as well: it
    returns 0 for them immediately, and the file is the only memory a per-call process has.
    """
    return _session_file(session, "symbolic").exists()


def note_symbolic_call(session: str) -> None:
    try:
        _session_file(session, "symbolic").touch()
        _session_file(session, "unheeded").unlink(missing_ok=True)
    except OSError:
        pass


def unheeded_count(session: str, increment: bool = False) -> int:
    ledger = _session_file(session, "unheeded")
    try:
        if increment:
            with open(ledger, "a", encoding="utf-8") as handle:
                handle.write("1")
        return ledger.stat().st_size if ledger.exists() else 0
    except OSError:
        return 0


def worth_nudging(session: str) -> bool:
    return uses_symbolic_tools(session) or unheeded_count(session) < GIVE_UP_AFTER


def first_words(command: str) -> list[str]:
    """The first word of each `&&`, `;` or `|` separated segment."""
    words = []
    for segment in re.split(r"&&|\|\||;|\|", command):
        parts = segment.strip().split()
        if parts:
            words.append(parts[0])
    return words


#: A file that is plainly not source: a log, a config, a lock file, data.
NOT_SOURCE = re.compile(r"\.(log|ya?ml|json|toml|ini|conf|cfg|lock|txt|csv|md|env)$", re.IGNORECASE)


def segment_for(command: str, commands: set[str]) -> str:
    """The `&&`-separated segment whose first word is one of `commands`."""
    for segment in re.split(r"&&|\|\||;|\|", command):
        parts = segment.strip().split()
        if parts and parts[0] in commands:
            return segment.strip()
    return ""


def asks_about_symbols(segment: str, searching: bool) -> bool:
    """Whether one shell segment asks something the index answers.

    Scoped to the segment, because judging the whole line let `cd /tmp && grep -rn thing .` through —
    the token after `cd` is `&&`. And it asks *where* as well as *what*: `grep ERROR /var/log/x.log`
    is a log question wearing an identifier's clothes.
    """
    tokens = segment.split()
    rest = [token for token in tokens[1:] if not token.startswith("-")]
    bare = [token.strip("\"'") for token in rest]
    if searching:
        if not bare or not IDENTIFIER.match(bare[0]):
            return False
        return not any(NOT_SOURCE.search(target) for target in bare[1:])
    return any(CODE.search(token) for token in bare)


def refuse(reason: str) -> int:
    print(reason, file=sys.stderr)
    return 2


def main() -> int:
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return 0

    tool = str(event.get("tool_name") or "")
    arguments = event.get("tool_input") or {}
    session = str(event.get("session_id") or os.getppid())
    prune()

    # Never refused — observed. This is the only way a per-call process can learn that the session
    # has the symbolic tools at all, and it decides whether further refusals are worth anything.
    if tool.startswith("mcp__serena__"):
        note_symbolic_call(session)
        return 0

    if not worth_nudging(session):
        return 0

    if tool == "Bash":
        command = str(arguments.get("command") or "")
        words = first_words(command)
        searching = next((word for word in words if word in SEARCH_COMMANDS), "")
        reading = next((word for word in words if word in READ_COMMANDS), "")
        if not searching and not reading:
            return 0
        # What it is aimed at, not just what it is: judging the verb alone refused
        # `cat .serena/project.yml`, a config file this rule's own message promises to let through.
        segment = segment_for(command, SEARCH_COMMANDS if searching else READ_COMMANDS)
        if not segment or not asks_about_symbols(segment, bool(searching)):
            return 0
        if already_nudged(session, "bash", command[:120]):
            return 0
        unheeded_count(session, increment=True)
        return refuse(
            f"That command was not run: it uses `{searching or reading}` to answer a question the "
            f"index answers better, and going through Bash reaches the same dead end as the tool "
            f"would.\n"
            f"  mcp__serena__find_symbol(name_path_pattern=...)        where it is defined\n"
            f"  mcp__serena__find_referencing_symbols(...)             who uses it\n"
            f"  mcp__serena__ide_read_symbol / ide_read_document       from the running IDE\n"
            f"If it is really about text or files — a log, a config, a build output — run it again "
            f"and it will go through."
        )

    if tool == "Grep":
        pattern = str(arguments.get("pattern") or "")
        # A regex is a text search and this has no opinion about it. A bare identifier is a question
        # about a symbol, which grep answers with every comment and string that contains the name.
        if not IDENTIFIER.match(pattern):
            return 0
        if already_nudged(session, "grep", pattern):
            return 0
        unheeded_count(session, increment=True)
        return refuse(
            f'Grep "{pattern}" was not run. Ask the index, which resolves what a text search cannot:\n'
            f'  mcp__serena__find_symbol(name_path_pattern="{pattern}")   the declaration\n'
            f"  mcp__serena__find_referencing_symbols(...)                callers, including overrides\n"
            f"  mcp__serena__ide_find_symbol / ide_hierarchy              the same, from the running IDE\n"
            f"If you want text — a log line, a config value, a string — run the same Grep again and it "
            f"will go through, or use a regex."
        )

    if tool != "Read":
        return 0

    path = str(arguments.get("file_path") or "")
    if not path or not CODE.search(path):
        return 0
    # A range means the caller already knows what they want.
    if arguments.get("offset") is not None or arguments.get("limit") is not None:
        return 0

    try:
        with open(path, "rb") as handle:
            lines = sum(1 for _ in handle)
    except OSError:
        return 0
    used = spend(session)
    over_budget = used > WHOLE_FILE_BUDGET
    if lines < WHOLE_FILE_IS_FINE and not over_budget:
        return 0
    if already_nudged(session, "read", path):
        return 0
    unheeded_count(session, increment=True)

    if over_budget and lines < WHOLE_FILE_IS_FINE:
        return refuse(
            f"Read of {path} was not run — that is {used} whole files opened in this session. Reading "
            f"them one after another to find something is the search the index does in one call:\n"
            f"  mcp__serena__find_symbol(name_path_pattern=...)        where it is defined\n"
            f"  mcp__serena__find_referencing_symbols(...)             who uses it\n"
            f"  mcp__serena__search_for_pattern(substring_pattern=...) text, but scoped\n"
            f"Run the same Read again and it will go through."
        )

    return refuse(
        f"Read of {path} ({lines} lines) was not run — the whole file would enter the context to "
        f"answer a question about part of it:\n"
        f'  mcp__serena__get_symbols_overview(relative_path="{path}")            what is in it\n'
        f"  mcp__serena__find_symbol(name_path_pattern=..., include_body=True)   one declaration\n"
        f'  mcp__serena__ide_read_document(path="{path}")                        the file as the editor\n'
        f"      holds it, unsaved edits included — which the disk does not have\n"
        f"If you do need the raw file, pass offset/limit, or run the same Read again and it will go "
        f"through."
    )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - a broken gate must never stop the agent
        sys.exit(0)
