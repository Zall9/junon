#!/usr/bin/env python3
"""Sends Read and Grep to JUNON/Serena — once for a guess, always for a whole large source file.

Measured, not assumed. Claude Code's own history over the last fortnight: 8 398 tool calls, of which
305 (3.6%) went to serena and 5 041 (60%) to the file tools. opencode's database says the same thing
louder — its `explorer` agent made 319 calls in the two days after its prompt was rewritten to insist
on the symbolic tools, and **none** of them was a serena call.

So this is not written in a prompt. A prompt is advice; this is the tool call not happening.

**A guess is refused once per target, then allowed.** A bare-identifier Grep, a short file, one file
too many: repeating the same call runs it, so a log file, a real text search and a config all pass on
the second attempt, and most pass on the first. `~/.claude/hooks/cbm-code-discovery-gate` already
blocks the first file-tool call of a session for codebase-memory; this is narrower on purpose.

**A whole read of a large source file inside the project is never allowed** — not on the second try,
not through `cat`. Measured on 2026-09-24 in opencode, which runs the same rules: retrying was the
cheapest way around the gate, and after a refusal agents reached for `sed`, `cat` and the next file
more than twice as often as for serena. The way out is `offset`/`limit`, which every agent has, so
nothing becomes unreachable. Claude Code cannot change which tool a hook lets run, so where opencode 2
answers that read with the file's outline, this refuses it and says how to read a range.

Only inside the session's project: JUNON has nothing to say about a file outside it.

Fails open. Every unexpected condition ends in exit 0, because a hook that blocks the agent when its
own logic breaks is worse than no hook.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys
import time
from pathlib import Path

#: Where a symbol tree exists and reading the whole file is the wasteful way in.
CODE = re.compile(
    r"\.(ts|tsx|js|jsx|mjs|cjs|py|kt|kts|go|java|rs|rb|php|c|h|hpp|cc|cpp|swift|scala|cs|vue|svelte)$",
    re.IGNORECASE,
)

#: A bare name — what someone types looking for a definition, not for text.
IDENTIFIER = re.compile(r"^[A-Za-z_$][A-Za-z0-9_$]{2,}$")

#: Under this, the whole file is the cheaper answer and a nudge would be noise. At or over it, a
#: whole read is never let through.
WHOLE_FILE_IS_FINE = 300

#: Whole-file reads of code allowed per session before the next one is refused.
#:
#: The size rule catches the wrong unit; this catches the wrong pattern — thirty files opened to find
#: one function. Swept over a fortnight of recorded calls before choosing: at five, the search agent's
#: refusal rate goes from 13.6% to 22.5%, while the agent that already reads by range moves 6.4% to
#: 7.4%. A rule that punishes the one doing it right is a rule that gets deleted.
WHOLE_FILE_BUDGET = 5

#: The same budget for a session that has never reached for a symbolic tool. Five whole files is a
#: generous allowance for someone who has shown they know the other route, and too generous for
#: someone who has not.
WHOLE_FILE_BUDGET_UNPROVEN = 3

#: Where the per-session memory lives: each hook call is its own process. Overridable so a test
#: never shares state with the session running it.
MARKERS = Path(os.environ.get("JUNON_GATE_MARKERS") or "/tmp")

#: Commands that answer a question the index answers better. Matched on the first word of each
#: `&&`/`;`/`|` segment — not a shell parser, and not trying to be. It catches
#: `cd /somewhere && grep -rn thing .`, which is the shape an agent used to walk around this gate on
#: the first day it ran; it misses subshells and aliases, deliberately, because a gate that tries to
#: understand shell is a gate that breaks builds at night.
SEARCH_COMMANDS = {"grep", "rg", "ag", "ack"}

#: Commands that print a whole file. `sed -n`, `head` and `tail` print a range and are not here: a
#: range is what the gate asks for.
READ_COMMANDS = {"cat", "bat", "less", "more", "nl"}

#: Refusals a session may ignore before the gate stops spending round-trips on its guesses.
#:
#: Some agents have no serena at all — three of the first five refusals went to one of them, naming a
#: tool it could not call. Which agent is asking is not in the hook's input, but what the session has
#: done is. The large-file rule does not give up: its way out is a range, not serena.
GIVE_UP_AFTER = 3


def already_nudged(session: str, kind: str, target: str) -> bool:
    """One refusal per session and target. The second attempt is the agent's call, and it stands."""
    digest = hashlib.sha256(f"{kind}:{target}".encode()).hexdigest()[:16]
    marker = MARKERS / f"junon-first-gate-{session}-{digest}"
    if marker.exists():
        return True
    marker.touch()
    return False


def spend(session: str) -> int:
    """How many whole-file code reads this session has made, counting this one.

    On disk because each hook call is its own process: a counter in memory would reset every time and
    the budget would never be reached.
    """
    ledger = MARKERS / f"junon-first-gate-{session}.reads"
    try:
        with open(ledger, "a", encoding="utf-8") as handle:
            handle.write("1")
        return ledger.stat().st_size
    except OSError:
        return 0


def budget_for(session: str) -> int:
    """Five for a session that has used the index, three for one that has not."""
    return WHOLE_FILE_BUDGET if uses_symbolic_tools(session) else WHOLE_FILE_BUDGET_UNPROVEN


def small_file_nudge_owed(session: str) -> bool:
    """Whether this session still has its one short-file nudge coming.

    A project made of small files was a way to read all of it without ever being asked: every read
    under the threshold, the budget never spent. Once per session, and only where there is something
    to teach — a session that has used a symbolic tool is left alone.
    """
    if uses_symbolic_tools(session):
        return False
    marker = _session_file(session, "smallnudge")
    if marker.exists():
        return False
    try:
        marker.touch()
    except OSError:
        return False
    return True


def prune() -> None:
    cutoff = time.time() - 86_400
    for stale in MARKERS.glob("junon-first-gate-*"):
        try:
            if stale.stat().st_mtime < cutoff:
                stale.unlink()
        except OSError:
            pass


def _session_file(session: str, suffix: str) -> Path:
    return MARKERS / f"junon-first-gate-{session}.{suffix}"


def uses_symbolic_tools(session: str) -> bool:
    """Whether this session has ever called an `mcp__serena__*` tool.

    Recorded by the hook itself, which is why it must be registered for those tools as well: it
    returns 0 for them immediately, and the file is the only memory a per-call process has.
    """
    return _session_file(session, "symbolic").exists()


def note_symbolic_call(session: str) -> None:
    try:
        _session_file(session, "symbolic").touch()
        _session_file(session, "unheeded").unlink(missing_ok=True)
    except OSError:
        pass


def unheeded_count(session: str, increment: bool = False) -> int:
    ledger = _session_file(session, "unheeded")
    try:
        if increment:
            with open(ledger, "a", encoding="utf-8") as handle:
                handle.write("1")
        return ledger.stat().st_size if ledger.exists() else 0
    except OSError:
        return 0


def worth_nudging(session: str) -> bool:
    return uses_symbolic_tools(session) or unheeded_count(session) < GIVE_UP_AFTER


def masked(command: str) -> str:
    """The command with `|`, `;` and `&` inside quotes masked.

    So `grep -E "tool|error" x.log` stays one search for a regex — split naively, it read as
    `grep "tool`, a bare identifier, and was refused.
    """
    quote = ""
    out = []
    for char in command:
        if quote:
            if char == quote:
                quote = ""
            out.append("\x01" if char in "|;&" else char)
        else:
            if char in "'\"":
                quote = char
            out.append(char)
    return "".join(out)


def first_words(command: str) -> list[str]:
    """The first word of each `&&`, `;` or `|` separated segment."""
    words = []
    for segment in re.split(r"&&|\|\||;|\|", command):
        parts = segment.strip().split()
        if parts:
            words.append(parts[0])
    return words


#: A file that is plainly not source: a log, a config, a lock file, data.
NOT_SOURCE = re.compile(r"\.(log|ya?ml|json|toml|ini|conf|cfg|lock|txt|csv|md|env)$", re.IGNORECASE)


def absolute(path: str, root: str) -> str:
    """Where a path argument points, resolved against the session's directory when relative."""
    return path if os.path.isabs(path) or not root else os.path.join(root, path)


def within_project(path: str, root: str) -> str | None:
    """The path relative to the project, or None when it lies outside — where JUNON has nothing to
    say, so neither has the gate. An unknown project counts as containing everything.

    Compared as written and then resolved: a path that does not exist has no real form, and
    comparing it with the project's real one would put every such path outside.
    """
    if not root:
        return path
    for base, target in ((root, path), (os.path.realpath(root), os.path.realpath(path))):
        inside = os.path.relpath(target, base)
        if inside == ".":
            return "."
        if not inside.startswith("..") and not os.path.isabs(inside):
            return inside
    return None


def line_count(path: str) -> int:
    try:
        with open(path, "rb") as handle:
            return sum(1 for _ in handle)
    except OSError:
        return 0


def segment_for(command: str, commands: set[str], unpiped: bool) -> str:
    """The first stage of a statement whose first word is one of `commands`.

    Only a first stage: a grep fed by a pipe filters output, not files. And a whole-file reader only
    when nothing follows it — `cat Big.php | wc -l` prints nothing whole.
    """
    for statement in re.split(r"&&|\|\||;", command):
        stages = statement.split("|")
        parts = stages[0].strip().split()
        if not parts or parts[0] not in commands:
            continue
        if unpiped and len(stages) > 1:
            continue
        return stages[0].strip()
    return ""


def large_whole_file_read(command: str, root: str) -> tuple[str, int] | None:
    """The first large source file inside the project a command prints whole: `cat Big.php`."""
    for statement in re.split(r"&&|\|\||;", command):
        if "|" in statement:
            continue
        tokens = statement.strip().split()
        if not tokens or tokens[0] not in READ_COMMANDS:
            continue
        for token in tokens[1:]:
            bare = token.strip("\"'")
            if bare.startswith("-") or not CODE.search(bare):
                continue
            path = absolute(bare, root)
            if within_project(path, root) is None:
                continue
            lines = line_count(path)
            if lines >= WHOLE_FILE_IS_FINE:
                return bare, lines
    return None


def asks_about_symbols(segment: str, searching: bool, root: str) -> bool:
    """Whether one shell segment asks something the index answers.

    Scoped to the segment, because judging the whole line let `cd /tmp && grep -rn thing .` through —
    the token after `cd` is `&&`. And it asks *where* as well as *what*: `grep ERROR /var/log/x.log`
    is a log question wearing an identifier's clothes.
    """
    tokens = segment.split()
    rest = [token for token in tokens[1:] if not token.startswith("-")]
    bare = [token.strip("\"'") for token in rest]

    def inside(token: str) -> bool:
        return within_project(absolute(token, root), root) is not None

    if searching:
        if not bare or not IDENTIFIER.match(bare[0]):
            return False
        return not any(NOT_SOURCE.search(target) or not inside(target) for target in bare[1:])
    return any(CODE.search(token) and inside(token) for token in bare)


def refuse(reason: str) -> int:
    print(reason, file=sys.stderr)
    return 2


def main() -> int:
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return 0

    tool = str(event.get("tool_name") or "")
    arguments = event.get("tool_input") or {}
    session = str(event.get("session_id") or os.getppid())
    root = str(event.get("cwd") or "")
    prune()

    # Never refused — observed. This is the only way a per-call process can learn that the session
    # has the symbolic tools at all, and it decides whether further refusals are worth anything.
    if tool.startswith("mcp__serena__"):
        note_symbolic_call(session)
        return 0

    if tool == "Bash":
        command = masked(str(arguments.get("command") or ""))
        # Ahead of the give-up: this is not a guess about intent, and a range is always there instead.
        large = large_whole_file_read(command, root)
        if large:
            unheeded_count(session, increment=True)
            name, lines = large
            return refuse(
                f"That command was not run, and will not be on another try: it prints {name} "
                f"({lines} lines) whole, and a source file this size is not read whole by any route.\n"
                f'  mcp__serena__ide_symbols_overview(relative_path="…")   its declarations, with their lines\n'
                f"  mcp__serena__find_symbol(name_path_pattern=..., include_body=True)   one declaration\n"
                f"For the text itself, print a range — `sed -n '120,180p' {name}` — or Read it with "
                f"offset and limit. A range is never refused."
            )
        if not worth_nudging(session):
            return 0
        words = first_words(command)
        searching = next((word for word in words if word in SEARCH_COMMANDS), "")
        reading = next((word for word in words if word in READ_COMMANDS), "")
        if not searching and not reading:
            return 0
        # What it is aimed at, not just what it is: judging the verb alone refused
        # `cat .serena/project.yml`, a config file this rule's own message promises to let through.
        segment = (
            segment_for(command, SEARCH_COMMANDS, unpiped=False)
            if searching
            else segment_for(command, READ_COMMANDS, unpiped=True)
        )
        if not segment or not asks_about_symbols(segment, bool(searching), root):
            return 0
        if already_nudged(session, "bash", command[:120]):
            return 0
        unheeded_count(session, increment=True)
        return refuse(
            f"That command was not run: it uses `{searching or reading}` to answer a question the "
            f"index answers better, and going through Bash reaches the same dead end as the tool "
            f"would.\n"
            f"  mcp__serena__find_symbol(name_path_pattern=...)        where it is defined\n"
            f"  mcp__serena__find_referencing_symbols(...)             who uses it\n"
            f"  mcp__serena__ide_read_symbol / ide_read_document       from the running IDE\n"
            f"If it is really about text or files — a log, a config, a build output — run it again "
            f"and it will go through."
        )

    if tool == "Grep":
        if not worth_nudging(session):
            return 0
        pattern = str(arguments.get("pattern") or "")
        # A regex is a text search and this has no opinion about it. A bare identifier is a question
        # about a symbol, which grep answers with every comment and string that contains the name.
        if not IDENTIFIER.match(pattern):
            return 0
        where = str(arguments.get("path") or "")
        if where and within_project(absolute(where, root), root) is None:
            return 0
        if already_nudged(session, "grep", pattern):
            return 0
        unheeded_count(session, increment=True)
        return refuse(
            f'Grep "{pattern}" was not run. Ask the index, which resolves what a text search cannot:\n'
            f'  mcp__serena__find_symbol(name_path_pattern="{pattern}")   the declaration\n'
            f"  mcp__serena__find_referencing_symbols(...)                callers, including overrides\n"
            f"  mcp__serena__ide_find_symbol / ide_hierarchy              the same, from the running IDE\n"
            f"If you want text — a log line, a config value, a string — run the same Grep again and it "
            f"will go through, or use a regex."
        )

    if tool != "Read":
        return 0

    path = str(arguments.get("file_path") or "")
    if not path or not CODE.search(path):
        return 0
    # A range means the caller already knows what they want.
    if arguments.get("offset") is not None or arguments.get("limit") is not None:
        return 0
    path = absolute(path, root)
    relative = within_project(path, root)
    if relative is None:
        return 0
    lines = line_count(path)

    # Not a guess, so ahead of the give-up and never let through on a second try: the way out is a
    # range, which every agent has.
    if lines >= WHOLE_FILE_IS_FINE:
        unheeded_count(session, increment=True)
        return refuse(
            f"Read of {path} ({lines} lines) was not run, and will not be on another try — the whole "
            f"file would enter the context to answer a question about part of it:\n"
            f'  mcp__serena__ide_symbols_overview(relative_path="{relative}")   its declarations, with their lines\n'
            f'  mcp__serena__get_symbols_overview(relative_path="{relative}", depth=1)   the same from serena\'s language server\n'
            f'  mcp__serena__find_symbol(name_path_pattern=..., relative_path="{relative}", include_body=True)   one declaration\n'
            f"For the text itself, pass offset and limit — a range is never refused."
        )

    if not worth_nudging(session):
        return 0
    used = spend(session)
    if used <= budget_for(session):
        if not small_file_nudge_owed(session):
            return 0
        unheeded_count(session, increment=True)
        return refuse(
            f"Read of {path} was not run — this session has not asked the index anything yet, and a "
            f"short file is still a file read whole:\n"
            f'  mcp__serena__ide_read_symbol(name=..., relative_path="{relative}")    one declaration, from the running IDE\n'
            f'  mcp__serena__find_symbol(name_path_pattern=..., relative_path="{relative}", include_body=True)\n'
            f"Said once per session. Run the same Read again and it will go through, as will every "
            f"short file after it."
        )
    if already_nudged(session, "read", path):
        return 0
    unheeded_count(session, increment=True)
    return refuse(
        f"Read of {path} was not run — that is {used} whole files opened in this session. Reading "
        f"them one after another to find something is the search the index does in one call:\n"
        f"  mcp__serena__find_symbol(name_path_pattern=...)        where it is defined\n"
        f"  mcp__serena__find_referencing_symbols(...)             who uses it\n"
        f"  mcp__serena__search_for_pattern(substring_pattern=...) text, but scoped\n"
        f"Run the same Read again and it will go through."
    )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 - a broken gate must never stop the agent
        sys.exit(0)
