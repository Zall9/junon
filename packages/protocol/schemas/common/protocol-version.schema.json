{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ide-bridge.dev/schemas/0.1.0/common/protocol-version.schema.json",
  "title": "IDEBP protocol version",
  "description": "A stable semantic version without prerelease or build metadata.",
  "type": "string",
  "maxLength": 64,
  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
}
