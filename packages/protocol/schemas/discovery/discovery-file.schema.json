{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ide-bridge.dev/schemas/0.1.0/discovery/discovery-file.schema.json",
  "title": "IDEBP discovery file",
  "description": "Private local metadata used to discover and authenticate to one daemon instance.",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/protocol-version.schema.json"
    },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^ws://(127\\.0\\.0\\.1|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/rpc$"
    },
    "token": {
      "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/authentication.schema.json#/$defs/token"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["protocolVersion", "endpoint", "token", "pid", "startedAt"],
  "additionalProperties": false
}
