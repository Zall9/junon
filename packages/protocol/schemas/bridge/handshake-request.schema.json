{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ide-bridge.dev/schemas/0.1.0/bridge/handshake-request.schema.json",
  "title": "bridge/handshake request",
  "description": "The first application message on every IDEBP WebSocket connection.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/json-rpc-id.schema.json"
    },
    "method": {
      "const": "bridge/handshake"
    },
    "params": {
      "type": "object",
      "properties": {
        "authentication": {
          "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/authentication.schema.json"
        },
        "role": {
          "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/session-role.schema.json"
        },
        "protocol": {
          "type": "object",
          "description": "Inclusive protocol version range. The daemon additionally verifies that minimum is not greater than maximum.",
          "properties": {
            "minimum": {
              "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/protocol-version.schema.json"
            },
            "maximum": {
              "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/protocol-version.schema.json"
            }
          },
          "required": ["minimum", "maximum"],
          "additionalProperties": false
        },
        "topology": {
          "$ref": "https://ide-bridge.dev/schemas/0.1.0/common/topology.schema.json"
        },
        "clientInfo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        }
      },
      "required": ["authentication", "role", "protocol", "topology", "clientInfo"],
      "additionalProperties": false
    }
  },
  "required": ["jsonrpc", "id", "method", "params"],
  "additionalProperties": false
}
