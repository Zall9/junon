        "name": "fixture",
        "roots": [
          {
            "rootId": "root_fixture_1",
            "name": "fixture",
            "uri": "file:///workspace/fixture/"
          }
        ],
        "workspaceEpoch": 1,
        "trust": "trusted"
      }
    ]
  }
}
