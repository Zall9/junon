{
  "name": "@ide-bridge/conformance",
  "version": "0.2.5",
  "private": true,
  "description": "IDE Bridge Conformance Suite \u2014 IDE-independent test suite for IDEBP adapter validation",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ide-bridge/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  }
}
