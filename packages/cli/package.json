{
  "name": "@ide-bridge/cli",
  "version": "0.2.5",
  "private": true,
  "description": "IDE Bridge CLI \u2014 foreground daemon lifecycle and authenticated health commands",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ide-bridge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ide-bridge/bridge-client": "workspace:*",
    "@ide-bridge/bridge-daemon": "workspace:*",
    "@ide-bridge/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
