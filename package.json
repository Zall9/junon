{
  "name": "ide-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "IDE Bridge — a protocol and daemon for AI agents to communicate with VS Code and JetBrains IDEs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "cli:smoke": "ide-bridge --help",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "protocol:fixtures": "node scripts/check-protocol-fixtures.ts",
    "protocol:generate": "node scripts/generate-types.ts",
    "protocol:generate:check": "node scripts/generate-types.ts --check",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ide-bridge/cli": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
